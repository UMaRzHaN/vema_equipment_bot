# ===== TELEGRAM =====
BOT_TOKEN=8169709623:AAG4nAORSm4VeMrTAXYGZpb0Jw_Agz90luk
# Full HTTPS URL where the bot is reachable (e.g. https://yourdomain.com)
WEBHOOK_URL=https://yourdomain.com
# Random secret for Telegram webhook validation (generate with: openssl rand -hex 32)
WEBHOOK_SECRET=change_me_random_hex_string
# Comma-separated Telegram user IDs with admin rights
ADMIN_IDS=70465073

# ===== SERVER =====
PORT=3000
# NODE_ENV: production | development
NODE_ENV=production

# ===== POSTGRESQL =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vema_bot
POSTGRES_USER=vema
POSTGRES_PASSWORD=change_me_strong_password
# Full connection URL used by node-pg-migrate (generate from the values above)
DATABASE_URL=postgresql://vema:changeme@localhost:5432/vema_bot

# ===== REDIS =====
REDIS_HOST=redis
REDIS_PORT=6379
# Optional Redis password (leave empty if none)
REDIS_PASSWORD=

# ===== APP =====
# Log level: error | warn | info | debug
LOG_LEVEL=info
# Days before overdue notification is sent to admins
OVERDUE_DAYS=7
# Session TTL in seconds (default: 1800 = 30 minutes)
SESSION_TTL=1800
