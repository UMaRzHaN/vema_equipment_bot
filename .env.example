# ===== TELEGRAM =====
# Get from @BotFather: /newbot
BOT_TOKEN=your_bot_token_here
# Full HTTPS URL of your server (no trailing slash)
# In Docker: set to your domain, e.g. https://bot.yourdomain.com
WEBHOOK_URL=https://yourdomain.com
# Webhook secret — generate with: openssl rand -hex 32
WEBHOOK_SECRET=change_me_min_32_chars_random_hex
# Comma-separated Telegram user IDs with admin rights
# Find your ID via @userinfobot
ADMIN_IDS=your_telegram_user_id

# ===== SERVER =====
PORT=3000
# NODE_ENV: production | development
NODE_ENV=production

# ===== POSTGRESQL =====
# In Docker: use service name "postgres" as host
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vema_bot
POSTGRES_USER=vema
POSTGRES_PASSWORD=change_me_strong_password_min_16_chars
# Must match POSTGRES_* vars above (used by node-pg-migrate)
DATABASE_URL=postgresql://vema:change_me_strong_password_min_16_chars@postgres:5432/vema_bot

# ===== REDIS =====
# In Docker: use service name "redis" as host
REDIS_HOST=redis
REDIS_PORT=6379
# Recommended: set a password in production
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=change_me_redis_password

# ===== APP =====
# Log level: error | warn | info | debug
LOG_LEVEL=info
# Days before overdue notification is sent to admins
OVERDUE_DAYS=7
# Session TTL in seconds (default: 1800 = 30 minutes)
SESSION_TTL=1800
# REST API key — protect /equipment and /actions endpoints
# Generate with: openssl rand -hex 32
API_KEY=change_me_api_key
